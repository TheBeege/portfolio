---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { homePath, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#about', label: t.nav.about },
  { href: '#professional-projects', label: t.nav.professionalProjects },
  { href: '#personal-projects', label: t.nav.personalProjects },
  { href: '#professional-experience', label: t.nav.experience },
  { href: '#community', label: t.nav.community },
  { href: '#contact', label: t.nav.contact },
];
---

<nav data-open-label={t.openMenu} data-close-label={t.closeMenu} class="fixed top-0 w-full bg-surface/80 backdrop-blur-md border-b border-white/10 z-50">
  <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href={homePath(lang)} class="text-lg font-bold hover:text-primary-light transition-colors">BB<span class="sr-only"> – {t.homeLabel}</span></a>

    <div class="flex items-center gap-4 md:gap-6">
      <!-- Desktop nav -->
      <div class="hidden md:flex gap-6 text-sm text-text-muted">
        {links.map((link) => (
          <a href={link.href} class="hover:text-text transition-colors">{link.label}</a>
        ))}
      </div>

      <div class="md:border-l md:border-white/10 md:pl-6">
        <LanguageSwitcher lang={lang} />
      </div>

      <!-- Hamburger button -->
      <button id="menu-toggle" class="md:hidden p-2 text-text-muted hover:text-text transition-colors" aria-label={t.openMenu} aria-expanded="false" aria-controls="mobile-menu">
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-surface/95 backdrop-blur-md">
    <div class="flex flex-col px-6 py-4 gap-4 text-text-muted">
      {links.map((link) => (
        <a href={link.href} class="hover:text-text transition-colors py-2">{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    const nav = toggle.closest('nav');
    const label = isOpen ? nav?.dataset.openLabel : nav?.dataset.closeLabel;
    if (label) toggle.setAttribute('aria-label', label);
  });

  // Close menu when a link is clicked
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      const openLabel = toggle?.closest('nav')?.dataset.openLabel;
      if (openLabel) toggle?.setAttribute('aria-label', openLabel);
    });
  });
</script>
