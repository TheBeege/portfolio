---
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.png';
import Layout from '../layouts/Layout.astro';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import OtherContributions from './OtherContributions.astro';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { content } from '../data/content';
import { experience, otherContributions, personalProjects, professionalProjects, RESUME_URL, type ProjectData } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = content[lang];

/** Merge language-neutral project data with this language's text */
function project(data: ProjectData) {
  const text = c.projects[data.id as keyof typeof c.projects];
  const altCount = text.imageAlts?.length ?? 0;
  if ((data.images?.length ?? 0) !== altCount) {
    throw new Error(
      `[${lang}] Project "${data.id}" has ${data.images?.length ?? 0} screenshot(s) but ${altCount} alt text(s) in src/data/content/${lang}.ts`
    );
  }
  return {
    ...text,
    tags: data.tags,
    links: data.links?.map((link) => ({ label: t.project[link.kind], url: link.url })),
    images: data.images?.map((src, i) => ({ src, alt: text.imageAlts![i] })),
  };
}

const contributions = otherContributions.map((entry) => ({
  ...c.otherContributions.entries[entry.id],
  tags: entry.tags,
}));
---

<Layout lang={lang} title={c.meta.title} description={c.meta.description} footerName={c.footerName}>
  <!-- Hero -->
  <div class="min-h-[70vh] flex items-center">
    <div class="max-w-5xl min-w-0 mx-auto px-6 flex flex-col md:flex-row items-center gap-8 md:gap-12">
      <div class="flex-1 min-w-0 order-2 md:order-1">
        <!-- Monospace suits Latin text; Korean falls back to wide full-width CJK mono glyphs -->
        <p class:list={['text-primary-light mb-4', lang === 'en' && 'font-mono']}>{c.hero.greeting}</p>
        <h1 class="text-5xl md:text-7xl font-bold mb-4">{c.hero.name}{c.hero.nameSuffix && <><wbr />{c.hero.nameSuffix}</>}</h1>
        <p class="text-text-muted mb-4">{c.hero.legalName}</p>
        <p class="text-xl md:text-2xl text-text-muted max-w-2xl mb-4">
          {c.hero.tagline}
        </p>
        <p class="mb-8">
          <span class="inline-block w-2 h-2 rounded-full bg-green-400 mr-2 align-middle" aria-hidden="true"></span><Fragment set:html={c.hero.availabilityHtml} />
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#contact" class="bg-primary hover:bg-primary-dark px-6 py-3 rounded-lg font-medium transition-colors">
            {c.hero.ctaContact}
          </a>
          <a href={RESUME_URL} target="_blank" rel="noopener noreferrer" class="border border-white/20 hover:border-white/40 px-6 py-3 rounded-lg font-medium transition-colors">
            {c.hero.ctaResume} <span aria-hidden="true">↗</span><span class="sr-only">{t.opensInNewTab}</span>
          </a>
          <a href="#professional-projects" class="border border-white/20 hover:border-white/40 px-6 py-3 rounded-lg font-medium transition-colors">
            {c.hero.ctaWork}
          </a>
        </div>
      </div>
      <div class="w-48 md:w-64 flex-shrink-0 order-1 md:order-2">
        <Image src={profileImage} alt={c.hero.photoAlt} width={256} height={256}
          class="w-full rounded-2xl border-2 border-primary/50" />
      </div>
    </div>
  </div>

  <!-- About -->
  <Section id="about" title={t.nav.about}>
    <div class="text-text-muted text-lg leading-relaxed max-w-3xl space-y-4">
      {c.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </Section>

  <!-- Professional Projects -->
  <Section id="professional-projects" title={t.nav.professionalProjects}>
    <div class="space-y-16">
      {professionalProjects.map((data) => {
        const { description, ...props } = project(data);
        return (
          <ProjectCard lang={lang} {...props}>
            <p>{description}</p>
          </ProjectCard>
        );
      })}

      <OtherContributions title={c.otherContributions.title} entries={contributions} />
    </div>
  </Section>

  <!-- Personal Projects -->
  <Section id="personal-projects" title={t.nav.personalProjects}>
    <div class="space-y-16">
      {personalProjects.map((data) => {
        const { description, ...props } = project(data);
        return (
          <ProjectCard lang={lang} {...props}>
            <p>{description}</p>
          </ProjectCard>
        );
      })}
    </div>
  </Section>

  <!-- Professional Experience -->
  <Section id="professional-experience" title={t.experienceHeading}>
    <div class="space-y-10">
      {experience.map((job) => {
        const text = c.experience[job.id];
        return (
          <div class:list={['border-l-2 pl-6', job.accent ? 'border-primary' : 'border-white/30']}>
            <h3 class="text-xl font-semibold">{text.title}</h3>
            <p class="text-primary-light text-sm mb-1">{text.org}</p>
            <p class="text-text-muted text-sm mb-3">{text.period}</p>
            <ul class="text-text-muted space-y-2 list-disc list-inside text-sm">
              {text.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        );
      })}

      <!-- Education -->
      <div class="mt-12 border-l-2 border-primary/50 pl-6">
        <h3 class="text-xl font-semibold">{c.education.degree}</h3>
        <p class="text-primary-light text-sm mb-1">{c.education.school}</p>
        <p class="text-text-muted text-sm">{c.education.period}</p>
      </div>
    </div>
  </Section>

  <!-- Community -->
  <Section id="community" title={t.nav.community}>
    <div class="text-text-muted text-lg leading-relaxed max-w-3xl space-y-4">
      {c.community.paragraphsHtml.map((html) => <p set:html={html} />)}
    </div>
  </Section>

  <!-- Contact -->
  <Section id="contact" title={c.contact.title}>
    <div class="max-w-2xl">
      <!-- Social & Professional -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        <a href="https://github.com/TheBeege" target="_blank" rel="noopener noreferrer"
          class="group flex items-center gap-3 rounded-lg bg-surface-light px-4 py-3 text-text-muted hover:text-text hover:bg-surface-light/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light">
          <svg class="w-5 h-5 shrink-0 text-text-muted group-hover:text-text transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
          <span class="sr-only">{t.opensInNewTab}</span>
        </a>

        <a href="https://www.linkedin.com/in/thebeege/" target="_blank" rel="noopener noreferrer"
          class="group flex items-center gap-3 rounded-lg bg-surface-light px-4 py-3 text-text-muted hover:text-text hover:bg-surface-light/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light">
          <svg class="w-5 h-5 shrink-0 text-text-muted group-hover:text-text transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span>LinkedIn</span>
          <span class="sr-only">{t.opensInNewTab}</span>
        </a>
      </div>

      <!-- Direct Contact -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="mailto:bryanberry235711@gmail.com"
          class="group flex items-center gap-3 rounded-lg bg-surface-light px-4 py-3 text-text-muted hover:text-text hover:bg-surface-light/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light">
          <svg class="w-5 h-5 shrink-0 text-text-muted group-hover:text-text transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
          </svg>
          <span>bryanberry235711@gmail.com</span>
        </a>

        <div class="flex items-center gap-3 rounded-lg bg-surface-light px-4 py-3 text-text-muted">
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3c-5.076 0-9.192 3.284-9.192 7.332 0 2.6 1.734 4.89 4.344 6.18-.192.716-1.248 4.584-1.284 4.872 0 0-.024.204.108.288a.383.383 0 00.312.012s4.872-3.204 5.592-3.708c.372.048.756.072 1.128.072 5.076 0 9.192-3.284 9.192-7.332S17.076 3 12 3z"/>
          </svg>
          <span>{c.contact.kakao}</span>
        </div>

        <a href="tel:+821050555576"
          class="group flex items-center gap-3 rounded-lg bg-surface-light px-4 py-3 text-text-muted hover:text-text hover:bg-surface-light/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light">
          <svg class="w-5 h-5 shrink-0 text-text-muted group-hover:text-text transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
          </svg>
          <span>+82 10-5055-5576 <span class="text-sm">({c.contact.phoneKr})</span></span>
        </a>

        <a href="tel:+19548507518"
          class="group flex items-center gap-3 rounded-lg bg-surface-light px-4 py-3 text-text-muted hover:text-text hover:bg-surface-light/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light">
          <svg class="w-5 h-5 shrink-0 text-text-muted group-hover:text-text transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
          </svg>
          <span>+1 954-850-7518 <span class="text-sm">({c.contact.phoneUs})</span></span>
        </a>
      </div>
    </div>
  </Section>
</Layout>
