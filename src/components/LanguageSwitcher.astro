---
import { homePath, languages, LANG_STORAGE_KEY, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const others = (Object.keys(languages) as Lang[]).filter((code) => code !== lang);
---

<div class="flex items-center gap-1" role="group" aria-label={t.switchLanguage}>
  <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.966 8.966 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
  </svg>
  {others.map((code) => (
    <a
      href={homePath(code)}
      hreflang={code}
      lang={code}
      data-lang-switch={code}
      class="text-sm text-text-muted hover:text-text transition-colors px-1 py-2 whitespace-nowrap"
    >
      {languages[code].label}
    </a>
  ))}
</div>

<script define:vars={{ storageKey: LANG_STORAGE_KEY }}>
  document.querySelectorAll('[data-lang-switch]').forEach((link) => {
    link.addEventListener('click', () => {
      // Remember the explicit choice so automatic detection never overrides it
      try {
        localStorage.setItem(storageKey, link.dataset.langSwitch);
      } catch {
        // Storage unavailable (private mode, blocked). Detection still lets this click
        // through because it skips visitors arriving from another page on this site.
      }
      // Keep the query string and stay on the same section after switching
      link.setAttribute('href', link.pathname + location.search + location.hash);
    });
  });
</script>
