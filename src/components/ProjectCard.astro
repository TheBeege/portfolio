---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  company?: string;
  roles?: string[];
  tags: string[];
  links?: { label: string; url: string }[];
  images?: { src: string; alt: string }[];
  highlight?: string;
  teamSize?: string;
  companyContext?: string;
}

const { title, company, roles, tags, links, images, highlight, teamSize, companyContext } = Astro.props;

// Screenshots not yet added to public/ render as placeholders until the file exists
const screenshots = images?.map((img) => ({
  ...img,
  missing: !fs.existsSync(path.join(process.cwd(), 'public', img.src)),
}));
---

<div class="bg-surface-light rounded-xl p-8 border border-white/10">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
    <h3 class="text-2xl font-semibold">{title}</h3>
    {(company || roles || teamSize || companyContext) && (
      <div class="flex flex-col items-start md:items-end gap-1 text-sm text-text-muted shrink-0">
        {company && <span>{company}</span>}
        {companyContext && <span class="text-xs italic">{companyContext}</span>}
        {roles && <span>{roles.join(" / ")}</span>}
        {teamSize && <span>Team: {teamSize}</span>}
      </div>
    )}
  </div>

  <!-- Links -->
  {links && links.length > 0 && (
    <div class="flex gap-3 text-sm text-text-muted mb-4">
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary-light transition-colors">{link.label} ↗</a>
      ))}
    </div>
  )}

  <!-- Description (slot) -->
  <div class="text-text-muted mb-6">
    <slot />
  </div>

  <!-- Highlight -->
  {highlight && (
    <blockquote class="border-l-4 border-primary bg-primary/10 rounded-r-lg px-4 py-3 mb-6 text-text-muted italic">
      {highlight}
    </blockquote>
  )}

  <!-- Images -->
  {screenshots && screenshots.length > 0 && (
    <div class="grid md:grid-cols-3 gap-4 mb-6">
      {screenshots.map((img) => img.missing ? (
        <div class="aspect-[3/2] rounded-lg border-2 border-dashed border-white/20 flex flex-col items-center justify-center gap-2 p-4 text-center text-text-muted">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
          </svg>
          <span class="text-sm">Screenshot coming soon</span>
          {import.meta.env.DEV && <code class="text-xs break-all">public{img.src}</code>}
        </div>
      ) : (
        <button type="button" data-lightbox aria-label={`View full size: ${img.alt}`} class="group rounded-lg cursor-zoom-in">
          <img src={img.src} alt={img.alt} width={600} height={400} loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover object-top rounded-lg border border-white/10 group-hover:border-white/30 transition-colors" />
        </button>
      ))}
    </div>
  )}

  <!-- Tags -->
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="text-xs bg-primary/20 text-primary-light px-2 py-1 rounded">{tag}</span>
    ))}
  </div>
</div>
