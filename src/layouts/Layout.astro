---
import '../styles/global.css'
import MobileNav from '../components/MobileNav.astro'
import Lightbox from '../components/Lightbox.astro'
import { defaultLang, homePath, languages, LANG_STORAGE_KEY, type Lang } from '../i18n/config'
import { useTranslations } from '../i18n/ui'

interface Props {
  lang: Lang;
  title: string;
  description: string;
  footerName: string;
  ogImage?: string;
  url?: string;
}

const {
  lang,
  title,
  description,
  footerName,
  ogImage = "/og-image.png",
  url = "https://portfolio.beege.works",
} = Astro.props;

const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, url).href;
const allLangs = Object.keys(languages) as Lang[];
// Language-specific URLs for the home page, used for hreflang and the detection redirect
const langPaths = Object.fromEntries(allLangs.map((code) => [code, homePath(code)]));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/*
      Automatic language detection, placed first in <head> so the redirect happens before
      anything renders. Only runs on the default (English) page so a direct link to /ko/
      is always honoured, and so is navigation from another page on this site. An explicit
      choice made with the language switcher wins over the browser's language list.
    */}
    {lang === defaultLang && (
      <script is:inline define:vars={{ storageKey: LANG_STORAGE_KEY, current: lang, langPaths }}>
        (function () {
          // Arriving from another page on this site (e.g. the language switcher) means the
          // visitor chose this page, even if their choice could not be saved.
          try {
            if (document.referrer && new URL(document.referrer).origin === location.origin) return;
          } catch (e) {}
          var preferred = null;
          try {
            preferred = localStorage.getItem(storageKey);
          } catch (e) {}
          if (!preferred) {
            var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
            for (var i = 0; i < list.length; i++) {
              var base = String(list[i] || '').toLowerCase().split('-')[0];
              if (langPaths[base]) {
                preferred = base;
                break;
              }
            }
          }
          if (preferred && preferred !== current && langPaths[preferred]) {
            location.replace(langPaths[preferred] + location.search + location.hash);
          }
        })();
      </script>
    )}

    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternate languages -->
    {allLangs.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(langPaths[code], url).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(langPaths[defaultLang], url).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${url}${ogImage}`} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {allLangs.filter((code) => code !== lang).map((code) => (
      <meta property="og:locale:alternate" content={languages[code].ogLocale} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${url}${ogImage}`} />

    <title>{title}</title>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Bryan Berry",
      "url": url,
      "jobTitle": "Engineering Leader",
      "knowsLanguage": ["en", "ko"],
      "sameAs": [
        "https://github.com/TheBeege",
        "https://www.linkedin.com/in/thebeege/",
        "https://www.instagram.com/tehbeege"
      ],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Georgia Institute of Technology"
      }
    })} />
  </head>
  <body class="bg-surface text-text min-h-screen antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      {t.skipToContent}
    </a>

    <MobileNav lang={lang} />

    <main id="main-content" class="pt-20">
      <slot />
    </main>

    <Lightbox lang={lang} />

    <footer class="border-t border-white/10 py-8 text-center text-text-muted text-sm">
      <div class="max-w-5xl mx-auto px-6">
        © {new Date().getFullYear()} {footerName}
      </div>
    </footer>
  </body>
</html>
